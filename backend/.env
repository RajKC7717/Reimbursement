# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reimbursement_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=reimbursement_super_secret_jwt_key_2024_dev
JWT_REFRESH_SECRET=reimbursement_refresh_secret_jwt_key_2024_dev
